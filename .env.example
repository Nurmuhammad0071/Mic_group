# Telegram bot — get a token from @BotFather, and your chat/channel id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: forward leads by email (e.g. via Resend, SendGrid, or SMTP)
LEAD_NOTIFY_EMAIL=info@micgroup.uz

# Optional: CRM webhook (Bitrix24, AmoCRM, etc.) — POST the lead payload here
CRM_WEBHOOK_URL=
